{
  "rewrites": [
    { "source": "/((?!api/|_vercel/).*)", "destination": "/soccerAI-app.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
